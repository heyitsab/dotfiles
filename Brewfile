# Core tools
brew "tmux"
brew "neovim"
brew "git"
brew "starship"
brew "fzf"          # Fuzzy finder - essential for productivity
brew "ripgrep"      # Fast grep alternative
brew "bat"          # Better cat with syntax highlighting
brew "eza"          # Modern ls replacement
brew "fd"           # Fast find alternative
brew "zoxide"       # Smart cd that learns your habits

# Optional but recommended
brew "gh"           # GitHub CLI (already installed)
brew "jq"           # JSON processor
brew "tree"         # Directory visualization

# Fonts
cask "font-hack-nerd-font"  # Nerd Font for terminal icons

# Cask applications
cask "ghostty"      # Terminal emulator
